{
  "entities": {
    "products": {
      "title": "products",
      "description": "Products catalog for Malik Oil Expellers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "urduName": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "unit": { "type": "string" },
        "image": { "type": "string" },
        "stock": { "type": "number" },
        "category": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "price", "unit", "category", "stock"]
    },
    "categories": {
      "title": "categories",
      "description": "Product categories",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" }
      },
      "required": ["name"]
    },
    "orders": {
      "title": "orders",
      "description": "Store orders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNo": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "province": { "type": "string" },
        "orderDate": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "shipping": { "type": "number" },
        "discount": { "type": "number" },
        "discountCode": { "type": "string" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "orderStatus": { "type": "string" }
      },
      "required": ["invoiceNo", "customerName", "customerPhone", "items", "total"]
    },
    "customers": {
      "title": "customers",
      "description": "Registered customers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "totalOrders": { "type": "number" },
        "totalSpent": { "type": "number" },
        "lastOrderDate": { "type": "string" }
      },
      "required": ["name", "phone"]
    },
    "discountCodes": {
      "title": "discountCodes",
      "description": "Discount and promotional codes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "type": { "type": "string" },
        "value": { "type": "number" },
        "minOrderAmount": { "type": "number" },
        "isActive": { "type": "boolean" },
        "description": { "type": "string" }
      },
      "required": ["code", "type", "value", "isActive"]
    },
    "settings": {
      "title": "settings",
      "description": "Store configuration and website settings",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "tagline": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "announcementText": { "type": "string" },
        "showAnnouncement": { "type": "boolean" },
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "heroImageUrl": { "type": "string" },
        "logoUrl": { "type": "string" },
        "estYear": { "type": "string" },
        "standardShippingRate": { "type": "number" },
        "freeShippingThreshold": { "type": "number" },
        "taxRatePercent": { "type": "number" },
        "customNoticeText": { "type": "string" },
        "showCustomNotice": { "type": "boolean" }
      },
      "required": ["storeName", "phone"]
    },
    "reviews": {
      "title": "reviews",
      "description": "Customer reviews and testimonials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "author": { "type": "string" },
        "city": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["productId", "author", "comment", "rating"]
    }
  }
}
