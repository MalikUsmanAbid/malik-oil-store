# Server-side only. Never prefix service-account credentials with VITE_.
FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"malik-oil-expellers","client_email":"...","private_key":"..."}
FIREBASE_DATABASE_ID=(default)

# App Check: configure both sides before enabling enforcement.
# Register the web app with reCAPTCHA Enterprise and allow malikoil.vercel.app.
# This is a public site key, never a service-account key or reCAPTCHA secret.
VITE_FIREBASE_APP_CHECK_SITE_KEY=
VITE_FIREBASE_APP_CHECK_PROVIDER=enterprise
FIREBASE_APP_CHECK_REQUIRED=false
