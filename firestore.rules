rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && request.auth.token.admin == true; }
    match /products/{id} { allow read: if true; allow write: if admin(); }
    match /categories/{id} { allow read: if true; allow write: if admin(); }
    match /settings/{id} { allow read: if true; allow write: if admin(); }
    match /discountCodes/{id} { allow read: if true; allow write: if admin(); }
    match /orders/{id} {
      allow read: if admin() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      // Orders and stock reservations must be created together by the checkout server.
      allow create: if false;
      allow update, delete: if false; // All staff changes use the transactional server endpoint.
    }
    match /customers/{id} { allow read, write: if admin(); }
    match /reviews/{id} {
      allow read: if true;
      allow create: if false; // Validated and rate-limited by the review API.
      allow update, delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
